# SISNAV COSTEIRO - variáveis do back-end (Railway). NÃO commitar o .env real.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<chave service_role - secreta>
SISNAV_ADMIN_KEY=<chave do painel admin>
ALLOWED_ORIGINS=https://<site>.netlify.app
XAI_API_KEY=<chave xAI do KRATOS>
XAI_MODEL=grok-4.20-reasoning
# v3.8.1: SEALAGOM_API_TOKEN removido (Sealagom desligado na v3.7.0; avisos vêm da DHN).
# Opcionais - Avisos-Rádio DHN (dhn_avradio.py):
# DHN_AVRADIO_CACHE_S=1800   # cache da consulta em segundos (padrão 30 min)
# DHN_AVRADIO_URL=           # contingência: endereço fixo do avradio_NN.json
