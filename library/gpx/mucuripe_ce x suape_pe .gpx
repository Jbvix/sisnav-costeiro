<?xml version="1.0"?>
<gpx version="1.1" creator="OpenCPN" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.topografix.com/GPX/1/1" xmlns:gpxx="http://www.garmin.com/xmlschemas/GpxExtensions/v3" xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd" xmlns:opencpn="http://www.opencpn.org">
  <rte>
    <name>Mucuripe x Suape (Offshore)</name>
    <extensions>
      <opencpn:guid>143e0000-7d70-4a89-ad99-36b24c56ffff</opencpn:guid>
      <opencpn:viz>1</opencpn:viz>
      <opencpn:start>Porto de Mucuripe</opencpn:start>
      <opencpn:end>Porto de Suape</opencpn:end>
      <opencpn:planned_speed>10.00</opencpn:planned_speed>
      <opencpn:time_display>PC</opencpn:time_display>
      <gpxx:RouteExtension>
        <gpxx:IsAutoNamed>false</gpxx:IsAutoNamed>
      </gpxx:RouteExtension>
    </extensions>
    <!-- 1. Mucuripe Departure -->
    <rtept lat="-3.6950" lon="-38.4680">
      <name>001-MUCURIPE</name>
      <sym>diamond</sym>
      <type>WPT</type>
    </rtept>
    <!-- 2. Exit Channel/Breakwater -->
    <rtept lat="-3.6500" lon="-38.4500">
      <name>002-SAIDA</name>
      <sym>diamond</sym>
      <type>WPT</type>
    </rtept>
    <!-- 3. Ceara Coast -->
    <rtept lat="-3.8500" lon="-38.2000">
      <name>003-COSTA</name>
      <sym>diamond</sym>
      <type>WPT</type>
    </rtept>
    <!-- 4. Appr Mossoro -->
    <rtept lat="-4.2000" lon="-37.8000">
      <name>004-MOSSORO-OFF</name>
      <sym>diamond</sym>
      <type>WPT</type>
    </rtept>
    <!-- 5. Offshore Platforms (Outer Passage) -->
    <rtept lat="-4.4000" lon="-37.4000">
      <name>005-UBARANA-W</name>
      <sym>diamond</sym>
      <type>WPT</type>
    </rtept>
    <!-- 6. Offshore Macau (Clear of Fields) -->
    <rtept lat="-4.5500" lon="-36.8000">
      <name>006-MACAU-OFF</name>
      <sym>diamond</sym>
      <type>WPT</type>
    </rtept>
    <!-- 7. Offshore Guamare/Galinhos -->
    <rtept lat="-4.6500" lon="-36.2000">
      <name>007-GUAMARE-OFF</name>
      <sym>diamond</sym>
      <type>WPT</type>
    </rtept>
    <!-- 8. Approach Calcanhar (Safe Distance) -->
    <rtept lat="-4.8500" lon="-35.6000">
      <name>008-CALCANHAR-N</name>
      <sym>diamond</sym>
      <type>WPT</type>
    </rtept>
    <!-- 9. Rounding the Corner -->
    <rtept lat="-5.1000" lon="-35.3000">
      <name>009-CALCANHAR-E</name>
      <sym>diamond</sym>
      <type>WPT</type>
    </rtept>
    <!-- 10. Natal Offshore -->
    <rtept lat="-5.7000" lon="-35.1000">
      <name>010-NATAL-OFF</name>
      <sym>diamond</sym>
      <type>WPT</type>
    </rtept>
    <!-- 11. Pipa Offshore -->
    <rtept lat="-6.2000" lon="-34.9500">
      <name>011-PIPA-OFF</name>
      <sym>diamond</sym>
      <type>WPT</type>
    </rtept>
    <!-- 12. Joao Pessoa Offshore -->
    <rtept lat="-7.0000" lon="-34.7000">
      <name>012-JPA-OFF</name>
      <sym>diamond</sym>
      <type>WPT</type>
    </rtept>
    <!-- 13. Approach Recife -->
    <rtept lat="-7.9000" lon="-34.7500">
      <name>013-RECIFE-APP</name>
      <sym>diamond</sym>
      <type>WPT</type>
    </rtept>
    <!-- 14. Approach Suape -->
    <rtept lat="-8.3000" lon="-34.9000">
      <name>014-SUAPE-APP</name>
      <sym>diamond</sym>
      <type>WPT</type>
    </rtept>
    <!-- 15. Suape -->
    <rtept lat="-8.3970" lon="-34.9590">
      <name>015-SUAPE</name>
      <sym>diamond</sym>
      <type>WPT</type>
    </rtept>
  </rte>
</gpx>
